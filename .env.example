# Copy to .env and run with: npm run dev

# The bot token from Settings → Developer → your bot → Token. On Yapin’ hosting this is set for you.
YAPIN_TOKEN=yb_your_token_here

# Channels that get every release post, comma-separated. Server admins can also use /releases channel.
# Names work: announcements  or  #announcements
# If the bot's servers share a channel name, add the server: My Server/announcements
# Ids work too (/channelid in a server lists them).
RELEASE_CHANNELS=

# How often to check npm, in minutes.
RELEASE_POLL_MINUTES=5

# Optional: a GitHub personal access token (starts with ghp_ or github_pat_, no scopes needed)
# for 5000 API requests an hour instead of 60. Leave empty if you don't have one.
GITHUB_TOKEN=

# Extra user ids allowed to use owner-only commands (/announce, /docsync). The bot's owner always is.
BOT_OWNERS=

# What to watch. The defaults are yapin.js.
# WATCH_PACKAGE=yapin.js
# WATCH_REPO=yapin-js/yapin.js
# WATCH_BRANCH=main

# Hot reload modules on save.
# NODE_ENV=development
